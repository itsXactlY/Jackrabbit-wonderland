[Unit]
Description=Mazemaker APK gateway mDNS advertisement (_mazemaker-gw._tcp)
Documentation=https://github.com/itsXactlY/Jackrabbit-wonderland
After=mazemaker-apk-gateway.service avahi-daemon.service
Wants=mazemaker-apk-gateway.service
PartOf=mazemaker-apk-gateway.service

# Without this unit the app CANNOT pair on a fresh install, and the failure is
# opaque: provision-apk.sh emits a deliberately host-less pairing code
# ({v,token,fp}), so the app has no address to dial and must find the gateway by
# browsing _mazemaker-gw._tcp. With nothing advertising, the app reports "could
# not find the gateway on this device" no matter how healthy the gateway is —
# the gateway itself has no mDNS code and never advertises on its own.
#
# [Unit], not [Service] — see the note in mazemaker-apk-gateway.service.
# No start limit. Five quick exits at boot (no network yet) used to stop this
# unit for good, silently; mdns-advertise.sh now waits for the network itself,
# and anything that still makes it exit is retried every 10 s, visibly.
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=MAZEMAKER_GATEWAY_HOME=%h/.mazemaker-gateway
# A foreground supervisor (Type=simple): it keeps avahi-publish-service
# running, republishes when the LAN address changes, and deregisters on stop.
# A missing avahi or cert exits 1 — install-apk-gateway.sh checks both and
# fails loudly first.
ExecStart=%h/projects/mazemaker-stack/gateway/mdns-advertise.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
