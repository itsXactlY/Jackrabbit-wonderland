# mazemaker-gateway: environment reference
# Every variable the gateway reads (lan_gateway.py, relay_client.py, dlm_vault.py). All are optional.
# The systemd units load ~/.mazemaker-gateway/apk-gateway.env and container/gateway.env.

# --- Listen ---------------------------------------------------------------
# GATEWAY_PORT=8080                 # HTTP(S) port (the units pass --port 8443)
# RAW_TCP_PORT=37374                # raw TCP (netcat) port
# SESSION_TTL=3000                  # session lifetime in seconds

# --- State and auth -----------------------------------------------------------
# MAZEMAKER_GATEWAY_HOME=~/.mazemaker-gateway   # token, TLS cert/key (provision-apk.sh writes them)
# GATEWAY_TOKEN=                    # bearer token; empty = read GATEWAY_TOKEN_FILE
# GATEWAY_TOKEN_FILE=~/.mazemaker-gateway/gateway.token
# GATEWAY_TLS_CERT=~/.mazemaker-gateway/gateway.crt
# GATEWAY_TLS_KEY=~/.mazemaker-gateway/gateway.key

# --- Agent (cmd:ariadne) ------------------------------------------------------
# ARIADNE_BIN=ariadne-agent         # the headless Ariadne agent
# ARIADNE_HOME=~/ariadne            # its home: config.yaml (model, mcp_servers.mazemaker), skills/

# --- What the gateway fronts --------------------------------------------------
# MM_POD_URL=http://127.0.0.1:8765  # Mazemaker pod behind cmd:pod (MAZEMAKER_POD_URL also read)
# MM_BRIDGE_URL=http://127.0.0.1:8769   # agent bridge behind cmd:bridge and /bridge/stream
# MM_LLM_URL=http://127.0.0.1:8080  # local model server behind cmd:llm (stays on loopback)
# MM_LLM_API_KEY=                   # its key, if it needs one; never sent to the phone
# GATEWAY_PROXY_TIMEOUT=900         # seconds a proxied pod/bridge call may take
# PULSE_SCRIPT=~/projects/pulse/scripts/pulse.py

# --- Relay (optional, dial-out) -----------------------------------------------
# MM_RELAY_URL=wss://relay.example/gw
# MM_RELAY_PUBLIC_URL=https://relay.example

# --- Wonderland OpenAI-compatible proxy (/v1/models, /v1/chat/completions) ----
# WONDERLAND_UPSTREAM_PROVIDER=openrouter
# WONDERLAND_UPSTREAM_BASE_URL=     # UPSTREAM_BASE_URL also read; default from the provider
# WONDERLAND_UPSTREAM_MODEL=        # LLM_MODEL also read
# WONDERLAND_UPSTREAM_API_KEY=      # UPSTREAM_API_KEY also read; else the provider key below
# WONDERLAND_UPSTREAM_CONTEXT_LENGTH=0
# WONDERLAND_UPSTREAM_MAX_OUTPUT_TOKENS=0
# PROXY_MODEL_ALIASES=wonderland,ariadne,proxy,default
# Provider keys, read for the matching WONDERLAND_UPSTREAM_PROVIDER:
# OPENROUTER_API_KEY=  OPENAI_API_KEY=  ANTHROPIC_API_KEY=  GEMINI_API_KEY=  HF_TOKEN=
# GLM_API_KEY=  KIMI_API_KEY=  MINIMAX_API_KEY=  MINIMAX_CN_API_KEY=  KILOCODE_API_KEY=
# XIAOMI_API_KEY=  NOUS_API_KEY=

# --- JackrabbitDLM key vault --------------------------------------------------
# DLM_HOST=127.0.0.1
# DLM_PORT=37373
# DLM_TIMEOUT=  DLM_RETRY=  DLM_RETRY_SLEEP=  DLM_DIR=  JACKRABBITDLM_HOME=
