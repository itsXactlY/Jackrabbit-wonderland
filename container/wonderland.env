# Single source of truth for projects that should call Wonderland.
# Load it from each project instead of copying these values.
#
# POSIX shell (bash/zsh):
#   set -a; . /home/alca/projects/hermes-crypto/container/wonderland.env; set +a
#
# fish shell:
#   for line in (grep -v '^#' /home/alca/projects/hermes-crypto/container/wonderland.env | grep '=')
#       set -gx (string split -m 1 = -- $line)
#   end
#
# direnv .envrc:
#   dotenv /home/alca/projects/hermes-crypto/container/wonderland.env
#
# Hermes Agent default provider (rewrites ~/.hermes/config.yaml):
#   /home/alca/projects/hermes-crypto/container/run-podman.sh configure-hermes

WONDERLAND_PROVIDER=wonderland
WONDERLAND_BASE_URL=http://127.0.0.1:18080/v1
WONDERLAND_MODEL=wonderland
WONDERLAND_API_KEY=local-wonderland

OPENAI_BASE_URL=http://127.0.0.1:18080/v1
OPENAI_API_BASE=http://127.0.0.1:18080/v1
OPENAI_API_KEY=local-wonderland
OPENAI_MODEL=wonderland
MODEL=wonderland
