# Optional gateway runtime settings for Podman.
# Copy to container/gateway.env for local use, or pass it with:
#   podman run --env-file container/gateway.env ...
#
# This file is for the Wonderland gateway's upstream provider config.
# Client projects should source container/wonderland.env instead.

WONDERLAND_UPSTREAM_PROVIDER=openrouter
WONDERLAND_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
WONDERLAND_UPSTREAM_MODEL=
WONDERLAND_UPSTREAM_API_KEY=
SESSION_TTL=3000
PROXY_MODEL_ALIASES=wonderland,hermes-agent,proxy,default
DLM_RETRY=1
DLM_RETRY_SLEEP=0.2
DLM_TIMEOUT=2

# Provider keys, if you prefer provider-specific env names:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=
