# Optional gateway runtime settings for Podman.
# Copy to container/gateway.env for local use, or pass it with:
#   podman run --env-file container/gateway.env ...
#
# This file is for the Wonderland gateway's upstream provider config.
# Client projects should source container/wonderland.env instead.

WONDERLAND_UPSTREAM_PROVIDER=openrouter
WONDERLAND_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
WONDERLAND_UPSTREAM_MODEL=
WONDERLAND_UPSTREAM_API_KEY=
SESSION_TTL=3000
PROXY_MODEL_ALIASES=wonderland,hermes-agent,proxy,default
DLM_RETRY=1
DLM_RETRY_SLEEP=0.2
DLM_TIMEOUT=2

# Upstream model context window.  Most providers report this via /v1/models
# and the gateway passes it through to downstream clients automatically.
# Set these only when the upstream omits or under-reports it (common for
# direct-MiniMax, Kimi, GLM, Hermes-4 endpoints).  Without this, clients
# default to 128k and silently truncate longer windows.
#   MiniMax-M2:        WONDERLAND_UPSTREAM_CONTEXT_LENGTH=204800
#   Kimi-K2:           WONDERLAND_UPSTREAM_CONTEXT_LENGTH=131072
#   GLM-4.6:           WONDERLAND_UPSTREAM_CONTEXT_LENGTH=200000
#   Hermes-4-405B:     WONDERLAND_UPSTREAM_CONTEXT_LENGTH=131072
# WONDERLAND_UPSTREAM_CONTEXT_LENGTH=
# WONDERLAND_UPSTREAM_MAX_OUTPUT_TOKENS=

# Provider keys, if you prefer provider-specific env names:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=
